---
import { Code } from "@astrojs/starlight/components";
import LineIcon from "./LineIcon.astro";
import LiveDemo from "./LiveDemo.vue";
import type { IconName } from "./icons";

interface Flow {
  id: string;
  label: string;
  api: string;
  icon: IconName;
  /** The answer in the decision tree that leads to this flow */
  when: string;
  summary: string;
  file: string;
  code: string;
  mark: number;
  receiver: string;
  /** Example of what the callback gets */
  response: [key: string, value: string | number][];
  /** Show Google's real button here instead of the example response */
  live?: boolean;
  note: string;
  link: { href: string; text: string };
}

const flows: Flow[] = [
  {
    id: "button",
    label: "Sign-in button",
    api: "GoogleSignInButton",
    icon: "button",
    when: "When they click",
    summary:
      "Google's own button. Users pick an account and you get an ID token that says who they are.",
    file: "LoginButton.vue",
    code: `<script setup>
import { ref } from "vue";
import {
  GoogleSignInButton,
  decodeCredential,
} from "vue3-google-signin";

const user = ref(null);
const onSuccess = ({ credential }) => {
  user.value = decodeCredential(credential);
};
</script>

<template>
  <GoogleSignInButton @success="onSuccess" />
  <p v-if="user">Signed in as {{ user.email }}</p>
</template>`,
    mark: 15,
    receiver: "@success",
    live: true,
    response: [
      ["credential", "eyJhbGciOiJSUzI1NiIsImtpZCI6IjVhYz…"],
      ["select_by", "btn"],
    ],
    note: "Decode it for the user's name, email and picture, and verify it on your server.",
    link: { href: "/guide/google-signin-button/", text: "Button guide" },
  },
  {
    id: "one-tap",
    label: "One Tap",
    api: "useOneTap",
    icon: "oneTap",
    when: "On its own",
    summary:
      "Google's prompt in the corner of the page. Returning users sign in with one tap, no button needed.",
    file: "App.vue",
    code: `<script setup>
import { useOneTap } from "vue3-google-signin";

useOneTap({
  onSuccess: ({ credential }) => {
    // Send the credential to your server to sign the user in
  },
});
</script>`,
    mark: 5,
    receiver: "onSuccess",
    response: [
      ["credential", "eyJhbGciOiJSUzI1NiIsImtpZCI6IjVhYz…"],
      ["select_by", "user"],
    ],
    note: "The same ID token as the button. Add autoSelect to skip the tap for returning users.",
    link: { href: "/guide/one-tap-login/", text: "One Tap guide" },
  },
  {
    id: "token",
    label: "Access token",
    api: "useTokenClient",
    icon: "key",
    when: "In the browser",
    summary:
      "Your own button opens Google's consent popup. You get an access token to call Google APIs from the browser.",
    file: "DriveButton.vue",
    code: `<script setup>
import { useTokenClient } from "vue3-google-signin";

const { isReady, login } = useTokenClient({
  scope: "https://www.googleapis.com/auth/drive.readonly",
  onSuccess: ({ access_token }) => {
    // Call the Google Drive API with the token
  },
});
</script>

<template>
  <button :disabled="!isReady" @click="login()">
    Connect Google Drive
  </button>
</template>`,
    mark: 6,
    receiver: "onSuccess",
    response: [
      ["access_token", "ya29.a0AeDClZBx7Kq…"],
      ["token_type", "Bearer"],
      ["expires_in", 3599],
      [
        "scope",
        "email profile openid https://www.googleapis.com/auth/drive.readonly",
      ],
    ],
    note: "The token lasts about an hour, and users can untick scopes, so check what they granted.",
    link: {
      href: "/guide/creating-custom-buttons/#with-usetokenclient",
      text: "Custom buttons guide",
    },
  },
  {
    id: "code",
    label: "Auth code",
    api: "useCodeClient",
    icon: "server",
    when: "On your server",
    summary:
      "Your own button again, but Google returns a one-time code. Your server exchanges it for access and refresh tokens.",
    file: "CalendarSync.vue",
    code: `<script setup>
import { useCodeClient } from "vue3-google-signin";

const { isReady, login } = useCodeClient({
  scope: "https://www.googleapis.com/auth/calendar.readonly",
  onSuccess: ({ code }) => {
    // Your server swaps the code for tokens
    fetch("/api/google", { method: "POST", body: code });
  },
});
</script>

<template>
  <button :disabled="!isReady" @click="login()">
    Sync my calendar
  </button>
</template>`,
    mark: 6,
    receiver: "onSuccess",
    response: [
      ["code", "4/0AeaYSHDqvN8…"],
      [
        "scope",
        "email profile openid https://www.googleapis.com/auth/calendar.readonly",
      ],
    ],
    note: "The refresh token stays on your server, so it can act for the user while they're away.",
    link: {
      href: "/guide/creating-custom-buttons/#verify-code-on-the-backend",
      text: "Exchange the code",
    },
  },
];
---

<flow-explorer class="not-content">
  <div class="tree">
    <p class="q root">What do you need from Google?</p>
    <svg class="links" viewBox="0 0 100 12" preserveAspectRatio="none" aria-hidden="true">
      <path d="M50 0V6M25 6H75M25 6V12M75 6V12"></path>
    </svg>
    <div class="row two">
      <p class="q">To know who the user is</p>
      <p class="q">To call Google APIs</p>
    </div>
    <svg class="links" viewBox="0 0 100 12" preserveAspectRatio="none" aria-hidden="true">
      <path d="M25 0V6M12.5 6H37.5M12.5 6V12M37.5 6V12M75 0V6M62.5 6H87.5M62.5 6V12M87.5 6V12"></path>
    </svg>
    <div class="row four">{flows.map((flow) => <p class="when">{flow.when}</p>)}</div>
    <svg class="links short" viewBox="0 0 100 12" preserveAspectRatio="none" aria-hidden="true">
      <path d="M12.5 0V12M37.5 0V12M62.5 0V12M87.5 0V12"></path>
    </svg>
  </div>
  <div class="tabs" role="tablist" aria-label="Sign-in flows">
    {
      flows.map((flow, i) => (
        <button
          type="button"
          role="tab"
          id={`flow-tab-${flow.id}`}
          aria-controls={`flow-${flow.id}`}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
        >
          <span class="head">
            <LineIcon name={flow.icon} size={20} />
            <span class="label">{flow.label}</span>
          </span>
          <code class="api">{flow.api}</code>
        </button>
      ))
    }
  </div>
  {
    flows.map((flow, i) => (
      <div
        class="panel"
        role="tabpanel"
        id={`flow-${flow.id}`}
        aria-labelledby={`flow-tab-${flow.id}`}
        hidden={i !== 0}
      >
        <div class="source">
          <p class="summary">{flow.summary}</p>
          <Code code={flow.code} lang="vue" title={flow.file} mark={flow.mark} />
        </div>
        <div class="result">
          <p class="receiver">
            <code>{flow.receiver}</code> receives
          </p>
          {flow.live ? (
            // Hydrates only when scrolled into view, so Google's script
            // stays off the first paint
            <LiveDemo client:visible />
          ) : (
          <code class="response">
              <span class="line">{"{"}</span>
              {flow.response.map(([key, value], n) => (
                <span class="line field" style={`--n: ${n}`}><span class="key">{key}</span>: {typeof value === "number" ? <span class="num">{value}</span> : <span class="str">"{value.split("/").map((part, j) => <>{j > 0 && <>/<wbr /></>}{part}</>)}"</span>},</span>
              ))}
              <span class="line">{"}"}</span>
            </code>
          )}
          <p class="note">
            {flow.note} <a href={flow.link.href}>{flow.link.text}</a>
          </p>
        </div>
      </div>
    ))
  }
</flow-explorer>

<script>
  // Tabs per the ARIA tabs pattern. Panels are server-rendered, so every
  // flow's code is in the HTML; showing a panel replays its response. The
  // sign-in button's panel holds the live demo.
  class FlowExplorer extends HTMLElement {
    connectedCallback() {
      const tabs = [
        ...this.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
      ];
      const select = (tab: HTMLButtonElement) => {
        for (const t of tabs) {
          const selected = t === tab;
          t.setAttribute("aria-selected", String(selected));
          t.tabIndex = selected ? 0 : -1;
          const panel = document.getElementById(
            t.getAttribute("aria-controls")!,
          );
          if (panel) panel.hidden = !selected;
        }
      };
      tabs.forEach((tab, i) => {
        tab.addEventListener("click", () => select(tab));
        tab.addEventListener("keydown", (event) => {
          const keys: Record<string, number> = {
            ArrowRight: i + 1,
            ArrowLeft: i - 1,
            Home: 0,
            End: tabs.length - 1,
          };
          if (!(event.key in keys)) return;
          event.preventDefault();
          const next = tabs[(keys[event.key] + tabs.length) % tabs.length];
          select(next);
          next.focus();
        });
      });
    }
  }
  customElements.define("flow-explorer", FlowExplorer);
</script>

<style>
  flow-explorer {
    display: block;
    margin-top: 2rem;
  }

  /* Decision tree whose four answers land on the four tabs */
  .tree {
    display: grid;
    padding-inline: calc(0.3rem + 1px);
  }
  .q {
    justify-self: center;
    margin: 0;
    padding: 0.4rem 0.95rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    background: color-mix(in srgb, var(--sl-color-gray-6) 60%, transparent);
    font-size: 0.9rem;
    color: var(--sl-color-white);
  }
  .root {
    font-family: "Outfit Variable", var(--__sl-font);
    font-weight: 600;
  }
  .row {
    display: grid;
    gap: 0.25rem;
  }
  .two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .four {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .when {
    margin: 0;
    font-size: 0.85rem;
    text-align: center;
    color: var(--sl-color-gray-3);
  }
  .links {
    display: block;
    width: 100%;
    height: 1.1rem;
  }
  .short {
    height: 0.6rem;
  }
  .links path {
    fill: none;
    stroke: var(--sl-color-gray-4);
    stroke-width: 1.5;
    stroke-dasharray: 3 3;
    vector-effect: non-scaling-stroke;
  }

  .tabs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.25rem;
    padding: 0.3rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 1.1rem;
    background: color-mix(in srgb, var(--sl-color-gray-6) 45%, transparent);
  }
  [role="tab"] {
    display: grid;
    gap: 0.15rem;
    padding: 0.7rem 1rem;
    border: 0;
    border-radius: 0.85rem;
    background: none;
    color: var(--sl-color-gray-2);
    font: inherit;
    text-align: start;
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  [role="tab"]:hover {
    color: var(--sl-color-white);
  }
  [role="tab"][aria-selected="true"] {
    background: var(--sl-color-gray-5);
    color: var(--sl-color-white);
  }
  [role="tab"]:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  .head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .head svg {
    flex: none;
    color: var(--sl-color-gray-3);
  }
  [aria-selected="true"] .head svg {
    color: var(--sl-color-accent-high);
  }
  .label {
    font-family: "Outfit Variable", var(--__sl-font);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .api {
    font-family: var(--__sl-font-mono);
    font-size: 0.78rem;
    color: var(--sl-color-gray-3);
  }
  [aria-selected="true"] .api {
    color: var(--sl-color-accent-high);
  }

  .panel {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    margin-top: 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 1.25rem;
    background: color-mix(in srgb, var(--sl-color-gray-6) 45%, transparent);
    overflow: hidden;
  }
  .panel[hidden] {
    display: none;
  }
  .source {
    padding: 1.5rem;
  }
  .summary {
    margin: 0 0 1rem;
    color: var(--sl-color-gray-2);
  }
  .result {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    border-inline-start: 1px solid var(--sl-color-gray-5);
  }
  .receiver,
  .note {
    margin: 0;
    font-size: 0.9rem;
    color: var(--sl-color-gray-3);
  }
  .note {
    margin-top: auto;
  }
  .receiver code {
    font-family: var(--__sl-font-mono);
    color: var(--sl-color-accent-high);
  }
  .note a {
    color: var(--sl-color-accent);
  }

  .response {
    display: grid;
    padding: 1rem 1.1rem;
    border-radius: 0.75rem;
    background: var(--sl-color-black);
    font-family: var(--__sl-font-mono);
    font-size: 0.85rem;
    line-height: 1.7;
    color: var(--sl-color-gray-3);
  }
  .field {
    padding-inline-start: 2ch;
    text-indent: -2ch;
    margin-inline-start: 2ch;
    overflow-wrap: break-word;
  }
  .key {
    color: var(--sl-color-white);
  }
  .str {
    color: var(--sl-color-accent-high);
  }
  .num {
    color: var(--sl-color-blue);
  }

  /* A response streams in, field by field, whenever its tab opens */
  @media (prefers-reduced-motion: no-preference) {
    .field {
      animation: stream 0.45s cubic-bezier(0.2, 0.8, 0.2, 1) both;
      animation-delay: calc(var(--n) * 110ms + 120ms);
    }
  }
  @keyframes stream {
    from {
      clip-path: inset(0 100% 0 0);
      opacity: 0.4;
    }
  }

  @media (max-width: 52rem) {
    .panel {
      grid-template-columns: minmax(0, 1fr);
    }
    .result {
      border-inline-start: 0;
      border-top: 1px solid var(--sl-color-gray-5);
    }
  }
  @media (max-width: 36rem) {
    /* Two-by-two tabs no longer line up with the tree's leaves */
    .tree {
      display: none;
    }
    .tabs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
