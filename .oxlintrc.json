{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "vue"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ]
  },
  "env": {
    "browser": true,
    "builtin": true
  },
  "ignorePatterns": ["dist", "docs/dist", "docs/.astro"],
  "overrides": [
    {
      "files": ["e2e/**"],
      "rules": {
        "no-underscore-dangle": "off",
        "unicorn/consistent-function-scoping": "off"
      }
    }
  ]
}
