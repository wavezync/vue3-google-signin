{
  "name": "vue3-google-signin",
  "version": "2.1.1",
  "description": "Google Sign-in for Vue3 with Google Identity Service",
  "keywords": [
    "composables",
    "google login",
    "google signin",
    "google-login",
    "google-signin",
    "gsi",
    "oauth2",
    "vue3",
    "vue3 google auth",
    "vue3 google identity",
    "vue3 google identity service",
    "vue3 google identity services",
    "vue3 google oauth",
    "vue3 google oauth2",
    "vue3 google signin",
    "vue3-auth",
    "vue3-google-auth",
    "vue3-google-login",
    "vue3-google-oauth",
    "vue3-google-oauth2",
    "vue3-google-signin"
  ],
  "homepage": "https://vue3-google-signin.wavezync.com",
  "license": "MIT",
  "author": {
    "name": "Kasun Vithanage",
    "email": "alankasun@gmail.com",
    "url": "https://kasvith.me"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wavezync/vue3-google-signin.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && tsdown",
    "docs:serve": "vitepress serve docs",
    "typecheck": "vue-tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "docs:dev": "vitepress dev docs --port 3001",
    "docs:build": "vitepress build docs",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "publint": "^0.3.25",
    "sass": "^1.71.1",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "unplugin-vue": "^8.0.0",
    "vite": "^8.3.5",
    "vitepress": "^1.0.0-rc.45",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "peerDependencies": {
    "vue": "^3"
  },
  "packageManager": "pnpm@12.15.0"
}
